   <pb xml:id="leaf001r" facs="uva.00157.001.jpg" type="recto"/>
   
   <lg type="poem">
    <head type="main"><subst><del rend="overstrike" hand="#h02" seq="1"><hi rend="underline">Carols at Seventy.</hi></del> <add place="above" hand="#h02" seq="2">A Carol&#8211;<del rend="overstrike" hand="#h01" seq="3">Cluster</del> at 69.</add></subst></head>
    
    <note type="authorial" place="right"><subst><del rend="overstrike" seq="1">themes</del> <add place="above" seq="2">rhapsodies,</add></subst></note>
    
    <l><add place="below"><metamark function="add" target="#a001">&#8248;</metamark></add><add place="above" xml:id="a001">A</add> Carol<del rend="overstrike">s</del> at <subst hand="#h02"><del rend="overstrike" seq="1">seventy</del> <add place="above" seq="2">sixty&#11840;nine</add></subst>! <subst><del rend="overstrike" seq="1">hapless</del> <del rend="overstrike" hand="#h02" seq="3"><add place="above" seq="2">age's</add></del></subst> <add place="below" hand="#h02"><metamark function="add" target="#a002">&#8248;</metamark></add><del rend="overstrike" hand="#h02"><add place="above" hand="#h02">old</add></del> repetitions,<lb/>
           divine!</l>
    
    <l>Of <subst hand="#h02"><del rend="overstrike" seq="1">ye</del> <del rend="overstrike" seq="3"><add place="above" seq="2">you</add></del> <add place="above" seq="4">ye</add></subst>, O God<add hand="#h02">,</add><del rend="overstrike" hand="#h02">&#8212;O</del> Life<add hand="#h02">,</add> <del rend="overstrike" hand="#h02">&#8212;O</del> Nature<add hand="#h02">,</add><del rend="overstrike" hand="#h02">&#8212;</del>Freedom<add hand="#h02">,</add><del rend="overstrike" hand="#h02">&#8212;</del><lb/> Poetry,</l>
    
     <l><subst hand="#h02"><del rend="overstrike" seq="1">Ye let</del> <add place="above" seq="2">Of <subst><del rend="overstrike" seq="1">you</del> <add place="above" seq="2">ye</add></subst>,</add></subst> the lines <subst hand="#h02"><del rend="overstrike" seq="1">absorbing sung with joy</del> <add place="above" seq="2">in faith and joy</add></subst> <add place="below"><metamark function="add" target="#a002">&#8248;</metamark></add><del rend="overstrike" hand="#h02"><add place="above" xml:id="a002">the <unclear reason="illegible" cert="low" resp="#km">same</unclear>&#8212;</add></del> <choice><orig>con<lb/>tinuing</orig><reg>continuing<lb/></reg></choice><add hand="#h02">,</add> <add place="above" hand="#h02" rend="marked">singing <del rend="overstrike" hand="#h02">on</del></add> on the same;</l>
    
    <l><add place="below"><metamark function="add" target="#a003">&#8248;</metamark></add><add place="above" xml:id="a003">Of</add> You, <del rend="overstrike">O</del> my Land&#8212;your rivers, prairies<lb/> States&#8212;of you O mottled Flag!</l>
    
    <l>Your aggregate <subst><del rend="overstrike" seq="1">majestic</del> <add place="above" seq="2">retained</add></subst>&#8212;<subst hand="#h02"><del rend="overstrike" seq="1">your</del> <add place="above" seq="2">&#8212;of</add></subst> north, south<lb/> east and west&#8212;<subst><del rend="overstrike" seq="1">your</del> <add place="above" seq="2">&#8212;their</add></subst> items all&#8212;none <add place="above">none deserted</add></l>
    
    <l>Of me myself <add place="below" hand="#h02"><metamark function="add" target="#a004">&#8248;</metamark></add><add xml:id="a004" place="above" hand="#h02">&#8212;the <!-- ASK BRETT --> <add place="below" hand="#h02"><metamark function="add" target="#a005">&#8248;</metamark></add><add xml:id="a005" place="above" hand="#h02" rend="marked">&#8212;the merry heart yet beating in my breast&#8212;</add>&#8212;the body wreck'd,</add> <del rend="overstrike" hand="#h02">wreck'd lamed</del> old, poor<lb/> <subst hand="#h02"><del rend="overstrike" seq="1">and helpless</del> <add place="above" seq="2"><del rend="overstrike" seq="3">and</del> and paralyzed,</add></subst>&#8212;<subst hand="#h02"><del rend="overstrike" seq="1">of fires</del> <add place="below" seq="2"><metamark function="add" target="#a006">&#8248;</metamark></add><add xml:id="a006" place="above" seq="2"><del rend="overstrike" seq="3">the</del> <add place="above" seq="4">of</add> burning fires yet in</add></subst> <del rend="overstrike" hand="#h02">made</del> the sluggish<lb/> blood</l>
    
    <l><del rend="overstrike" hand="#h02">Of a stout heart <add place="below"><metamark function="add" target="#a007">&#8248;</metamark></add><add place="above" xml:id="a007">yet</add> beating <subst><del rend="overstrike" seq="1">within</del> <add place="above" seq="2">in</add></subst> my breast<lb/> the same as ever</del></l>
    
    <l>Of undiminish'd Faith <subst><del rend="overstrike" seq="1">and</del> <add place="above" seq="2">&#8212;of</add></subst> many a loving<lb/> Friend.</l>
   </lg> 
   
