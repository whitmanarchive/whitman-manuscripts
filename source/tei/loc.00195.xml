   <text>
      <body>
         <pb facs="loc_ew.00071.jpg" xml:id="leaf001r" type="recto"/>
         <lg type="poem">
            
            <head type="main"><subst><del rend="overstrike" seq="1"><hi rend="underline">Swelling and Ebbing and hand in hand.</hi></del> <del rend="overstrike" seq="3"><add place="above" seq="2">Advancing, retreating,</add></del> <add place="above" seq="4">Ebb and Flood Tides.</add></subst></head>
            
            <l><subst><del rend="overstrike" seq="1">Swelling and ebbing</del> <add place="above" seq="2">Advancing, retreating,</add></subst> and hand in hand</l>
            
            <l><add place="below"><metamark function="add" target="#a001">&#8248;</metamark></add><add place="above" xml:id="a001">Duly,</add> With <add place="below"><metamark function="add" target="#a002">&#8248;</metamark></add><del rend="overstrike"><add place="above" xml:id="a002">their</add></del>  <subst><del rend="overstrike" seq="1">rhythmic</del> <add place="above" seq="2">turning</add></subst> steps <add place="below"><metamark function="add" target="#a003">&#8248;</metamark></add><add place="above" xml:id="a003">and mouths</add> to the <subst><del rend="overstrike" seq="1">left</del> <add place="above" seq="2">right</add></subst> or <subst><del rend="overstrike" seq="1">right</del> <add place="above" seq="2">the left,</add></subst></l>
            
            <l><del rend="overstrike"><gap reason="torn away" extent="about three words"/> <add place="above">reverting</add> <add place="above">re</add> <gap reason="torn away" extent="one word"/> <add place="above"><subst><del rend="overstrike" seq="1"><unclear reason="illegible" cert="medium" resp="#bb">many</unclear></del> <add place="above" seq="2">reverting</add></subst></add> <unclear reason="illegible" cert="high" resp="#bb">of the</unclear> <gap reason="illegible" extent="one word"/></del></l>
            
            <l><del rend="overstrike">With many a laugh</del></l>
            
            <l><subst><del rend="overstrike" seq="1">The</del> <add place="above" seq="2">You</add></subst> <del rend="overstrike">tides, the</del> <subst><del rend="overstrike" seq="1">ceaseless</del> <del rend="overstrike" seq="3"><add place="above" seq="2"> liquid</add></del></subst> <del rend="overstrike">tides like a</del> chorus<lb/> of brothers and sisters</l>
            
            <l><del rend="overstrike">Move forever <add place="below"><metamark function="add" target="#a004">&#8248;</metamark></add><add place="above" xml:id="a004">move,</add> round the circles of the earth,</del></l>
            <l>Moving forever round the circles of the earth,</l>
         </lg>
         <pb facs="loc_ew.00072.jpg" xml:id="leaf001v" type="verso"/>
         <note type="archival" place="left" hand="#h02">Manuscript of <hi rend="underline">Walt Whitman</hi></note>
      </body>
