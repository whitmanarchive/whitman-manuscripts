 <text type="manuscript">
  <body>
   <pb xml:id="leaf001r" facs="uva_es.00391_large.jpg" type="recto"/>
   <note type="authorial" place="above" hand="#h02" rend="circled">sent April 21 to Herald</note>
   <lg type="poem">
     <head>To Day</head> 
     <head xml:id="head1"><metamark function="question" target="#head1">?</metamark>To-Day and Thee</head>
    <lg type="linegroup">
     <l xml:id="tr001">The past <add place="below"><metamark function="add" target="#a003">&#8248;</metamark></add><add place="above" xml:id="a003">entire</add> with all its heroes, histories
            <lb/>arts,</l>
     <l xml:id="tr002"><del rend="overstrike">All</del> <add place="above">Its</add> <subst><del rend="overstrike" seq="1">train</del> <add place="above" seq="2">store</add></subst> of songs, inventions, voyages, teachers,
            <lb/><del rend="overstrike">and</del> books,</l>
     <l xml:id="tr003">The course of time and nations&#8212;Egypt
            <lb/><del rend="overstrike">a</del> and <subst><del rend="overstrike" seq="1">Palestine</del> <add place="above" seq="2">India,</add></subst> <del rend="overstrike">and</del> Greece, <add place="above">and</add> <del rend="overstrike">and</del>
            <lb/>Rome, <del rend="overstrike">the medieval growths</del></l>
     <l xml:id="tr004">The medieval growths, <del rend="overstrike">science,</del> battles for
            <lb/>liberty, modern science;</l>
    <listTranspose>
     <transpose>
      <ptr target="#tr003"/>
      <ptr target="#tr004"/>
      <ptr target="#tr001"/>
      <ptr target="#tr002"/>
     </transpose>
    </listTranspose>
    <l><del rend="overstrike">In thee</del></l>
    <l><del rend="overstrike">All for to-day and thee<add place="above">&#8212;to think of it!&#8212;</add>&#8212;thou art the
            <lb/>heir of all</del></l>
     <l><del rend="overstrike">To think of it!</del></l>
     <l><del rend="overstrike">To think of it<add place="above" seq="2">!</add>!&#8212;<unclear reason="illegible" resp="#bb" cert="low">a</unclear></del> <add place="above"><subst rend="overwrite"><del>a</del><add>A</add></subst>ll for to-day <add place="above">&amp; thee &#8212;</add>&#8212;<add place="above">&#8212;to think of it!&#8212;</add></add> the
            <lb/>heir <add place="below"><metamark function="add" target="#a001">&#8248;</metamark></add><add place="above" rend="marked" xml:id="a001">of all <del rend="overstrike">concentrated</del></add> in thee!</l>
    </lg>
    <lg type="linegroup">
     <l>The <add place="below"><metamark function="add" target="#a002">&#8248;</metamark></add><add place="above" hand="#h02" xml:id="a002">appointed</add> winners in the <add place="below"><metamark function="add" target="#a004">&#8248;</metamark></add><add place="above" xml:id="a004">long-stretch'd</add> game</l>
    </lg>
   </lg>
   <note type="archival" place="bottom" hand="#h03">hosioq</note>
   <pb xml:id="leaf001v" facs="uva_es.00392_large.jpg" type="verso"/>
   
</body>
