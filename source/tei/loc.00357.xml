    <text type="manuscript">
        <body>
            <pb xml:id="leaf001r" facs="loc_ew.00009.jpg" type="recto"/>
            <lg type="poem">
                <l>You <subst><del rend="overstrike" seq="1">distant</del><add place="above" seq="2">neighboring</add></subst> surf&#8212;you mystery<lb/> of swell and ebb!</l>
                <l>You <del rend="overstrike"><add place="above">ever&#11840;</add></del>hurrying waters, as I muse,<lb/> so much recalling strangely <add place="below"><metamark function="add" target="#a001">&#8248;</metamark></add><add xml:id="a001" place="above">to me</add>!</l>
                <l>With every heave and roll some<lb/> memory's light and shade,</l>
            </lg>
            
            <note type="archival" place="bottom" hand="#h02">46</note>
            
            <pb xml:id="leaf001v" facs="loc_ew.00010.jpg" type="verso"/>
        </body>
