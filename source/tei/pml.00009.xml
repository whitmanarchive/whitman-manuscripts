  <body>
   <pb xml:id="leaf001r" facs="pml_nk.00053_large.jpg" type="recto"/>
   <lg type="poem">
    <lg type="linegroup">
     <l><handShift new="#h02"/>Thou, <hi rend="doubleUnderline">Washington</hi>, art the worlds&#8212;not<lb/>
             yours alone, America.</l>
    
     <l><handShift new="#h01"/>Thou art the worlds&#8212;not ours<lb/>
             alone&#8212;<add place="below" rend="marked">Freedom's, humanity's</add></l>
    
    <l><handShift new="#h02"/><del rend="overstrike">Thou, in thy</del></l>
    
    <l>Thy <subst><del rend="overstrike" seq="1">deeds</del> <add place="below" seq="2"><metamark function="add" target="#a002">&#8248;</metamark></add><add place="above" xml:id="a002" seq="2"><del rend="overstrike">&amp;</del> fame</add></subst>, through <add place="below"><metamark function="add" target="#a001">&#8248;</metamark></add><add place="above" xml:id="a001">deathless</add> waves of emanation,<lb/>
           the <add place="below"><metamark function="add" target="#a003">&#8248;</metamark></add><add place="above" xml:id="a003">race's</add> common ownership becomes,</l>
     
    <l><handShift new="#h01"/><metamark function="transpose">*</metamark> (Thou, Washington, art not ours<lb/>
           alone&#8212;freedom's, humanity's<lb/>
           law's art thou)</l>
    </lg>
    
    <lg type="linegroup">
    <l>Not here within this</l>
    <l>There too forever springs his</l>
    <l><del rend="overstrike">A human tie</del></l>
    <l><del rend="overstrike">Launching out</del></l>
    <l><del rend="overstrike"><gap reason="illegible" extent="one character"/></del> Not for</l></lg>
 
   <pb xml:id="leaf001v" facs="pml_nk.00054_large.jpg" type="verso"/>
    <lg type="linegroup">
     <l><del rend="overstrike">Asia</del> Greets the antique the hero new?&#8212;it
     <lb/>is the same&#8212;<del rend="overstrike"><add place="above"><gap reason="illegible" extent="one character"/></add></del>the same eternal <add place="above">heart and </add> arm</l>
     <l><del rend="overstrike">With venerable smile Asia</del></l>
     <l><add><del rend="overstrike">Or</del> Courage, alertness, <add place="below"><metamark function="add" target="#a004">&#8248;</metamark></add><add place="above" rend="marked" xml:id="a004">patience,</add> hope, the same&#8212;e'en in defeat
      <lb/>defeated not
     <lb/>the same)</add></l>
     <l><subst><add place="above" seq="4">Old</add> <del rend="overstrike" seq="1">By</del> <del rend="overstrike" seq="3"><add place="above" seq="2">Or</add></del></subst> Asia's self, with venerable smile, 
      <lb/>seated amid the past,</l>
     <l><del rend="overstrike">To <add place="below"><metamark function="add" target="#a005">&#8248;</metamark></add><add place="above" xml:id="a005">thought</add> Washington</del></l>
     <l>Where</l>
     <l><subst><del rend="overstrike" seq="1">From every</del> <add place="above" seq="2">Where'er <del rend="overstrike">lives</del> the</add></subst> patriot <subst><del rend="overstrike" seq="1">souls,</del> <add place="above" seq="2">soul,</add></subst> <del rend="overstrike">, o</del> <add place="above"><del rend="overstrike">&#8212;</del>exists</add> <del rend="overstrike">what</del>
      <lb/><del rend="overstrike">time</del>, or night or day&#8212;<del rend="overstrike">what</del> or
      <lb/><subst><del rend="overstrike" seq="1">over</del> <del rend="overstrike" seq="3"><add place="above" seq="2">upon</add></del> <add place="below" seq="4">on</add></subst> land o<subst rend="overwrite"><del>n</del><add>r</add></subst> sea,</l>
     
     <l>Where, <hi rend="doubleUnderline">Washington</hi>, is <hi rend="underline">not</hi> thy
     <lb/>monument?</l>
    </lg>
    <delSpan rend="hashmark" spanTo="#d001"/>
    <lg type="linegroup">
     <l><del rend="overstrike">No</del></l>
     <l>Where</l>
     <l><del rend="overstrike">In souls that</del></l>
     <l><subst><del rend="overstrike" seq="1">In</del> <del rend="overstrike" seq="3"><add place="above" seq="2">To</add></del></subst> man exemplified, <subst><del rend="overstrike" seq="1">in</del> <add place="above" seq="2"><subst rend="overwrite"><del>T</del><add>to</add></subst></add></subst> patience
      <lb/>strength
      
     </l>
    </lg>
    <anchor xml:id="d001"/>
    
    
   </lg>
