            <lg type="poem">
                <l>On, on, awhile, ye jocund twain</l>
                <l><del rend="overstrike">Hold out ye</del></l>
                <l><subst><del rend="overstrike" seq="1">On, on,</del> <add place="above" seq="2">My</add></subst> <subst><del rend="overstrike" seq="1">a</del> <del rend="overstrike" seq="3"><add place="above" seq="2">my</add></del></subst> life and verse combining both<lb/>
                    and <del rend="overstrike">lif</del> youth and <add place="below"><metamark function="add" target="#a001">&#8248;</metamark></add><add place="above" xml:id="a001">varied</add> mid-age<del rend="overstrike">d</del> years</l>
                <pb facs="loc_ew.00061.jpg" xml:id="leaf001v" type="verso"/>
            </lg>
        </body>
