                <pb facs="loc_ew.00060.jpg" xml:id="leaf001r" type="recto"/>
                <!--THE CORRESPONDING IMAGE FOR THIS PAGE IN THE DATABASE IS UPSIDE DOWN.-->
                <l>On, on awhile, ye jocund twain</l>
                <l><del rend="overstrike">Hold out ye</del></l>
                <l><subst><rdg varSeq="1"><del rend="overstrike">On, on, my</del></rdg><rdg varSeq="2"><add rend="unmarked" place="above">My</add></rdg></subst> life and verse combining both<lb/>
                    and <del rend="overstrike">lif</del> youth and <add rend="insertion" place="above">varied</add> mid-aged years</l>
                <pb facs="loc_ew.00061.jpg" xml:id="leaf001v" type="verso"/>
                <note type="project" target="leaf03v">On the verso is an envelope reading "Walt Whitman Esq."</note> 
            </lg>
