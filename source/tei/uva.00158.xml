 <text type="manuscript">
  <body>
   <pb xml:id="leaf001r" facs="uva.00158.001.jpg" type="recto"/>
   <lg type="poem">
    
   <head rend="underline">Carols at nearing Seventy</head>
   
   <head rend="underline"><del rend="overstrike">A</del> <add place="above" hand="#h03">A</add> Carol<add>s</add> <add place="above"><metamark function="question">?</metamark>at</add> <subst><del rend="overstrike" seq="1">at</del> <add place="above" hand="#h03" seq="2">closing</add></subst> Sixty-Nine</head>

    <l><add place="above" hand="#h04">Sands on the shores of seventy&#8212;repetitions</add></l>
    
    <l><del rend="overstrike">A</del> <add place="above" hand="#h03">A</add> Carol <subst hand="#h03"><del rend="overstrike" seq="1">at</del> <add place="above" seq="2">closing</add></subst> sixty&#11840;nine&#8212;<add place="above"><metamark function="question">?</metamark>&#8212;old <subst><del rend="overstrike" seq="1">repetitions</del> <add place="above" seq="2"><metamark function="question">?</metamark> celebrations&#8212;</add></subst></add><subst><del rend="overstrike" seq="1" hand="#h03">old</del> <add hand="#h03" place="below" seq="2"><metamark function="add" target="#a001">&#8248;</metamark></add><del rend="overstrike" hand="#h02" seq="3"><add place="above" hand="#h03" xml:id="a001" seq="2">the</add></del></subst> <add place="above" hand="#h03">the <del rend="overstrike" hand="#h02">old </del></add> <subst><del rend="overstrike" hand="#h02" seq="1">repetitions,</del> <del rend="overstrike" hand="#h01" seq="3"><add place="above" hand="#h02" seq="2">celebrations,</add></del></subst>
            <lb/>rhapsodies</l> 

    <l>The <add place="above" hand="#h04">My</add> lines <subst hand="#h03"><del rend="overstrike" seq="1">in</del> <del rend="overstrike" seq="3"><add place="above" seq="2">of</add></del> <add place="above" seq="4">in</add></subst> joy and <subst><del rend="overstrike" hand="#h03" seq="1">hope</del> <del rend="overstrike" hand="#h02" seq="4"><add place="above" hand="#h03" seq="2">faith</add> <add place="above" hand="#h03" seq="3">the same,</add></del> <del rend="overstrike" hand="#h02" seq="6"><add place="below" hand="#h03" seq="5">faith</add></del> <add place="above" hand="#h02" seq="7">hope</add></subst> continuing on the same,</l>
    
    <l>Of ye, O God, <hi rend="tripleUnderline">L</hi>ife, <hi rend="tripleUnderline">N</hi>ature, <hi rend="tripleUnderline">F</hi>reedom, <hi rend="tripleUnderline">P</hi>oetry,</l>    
    
    <l><del rend="overstrike">Of ye, the lines in joy continuing on the same;</del></l>
    
    <l>Of you, my <hi rend="tripleUnderline">L</hi>and&#8212;your rivers, prairies, <hi rend="tripleUnderline">S</hi>tates&#8212;
     <lb/><del rend="overstrike" hand="#h03">of</del> you, <del rend="overstrike" hand="#h03">O</del> mottled Flag <add place="above" hand="#h02">I love</add>!</l>
    
    <l>Your aggregate retain'd <add place="below" hand="#h4"><metamark function="add" target="#a002">&#8248;</metamark></add><add place="above" rend="marked" xml:id="a002">entire</add>&#8212;<subst><del rend="overstrike" seq="1">of</del> <add place="above" seq="2">O<add hand="#h03" seq="3">f</add></add></subst> north, south, east and
           <lb/>west, <subst><del rend="overstrike" seq="1">their</del> <add place="above" seq="2">your</add></subst> items all&#8212;none, none deserted;</l>
    
    <l>Of me myself&#8212;the <subst><del rend="overstrike" hand="#h02" seq="1">merry</del> <del rend="overstrike" hand="#h03" seq="3"><add place="above" hand="#h01" seq="2"><metamark function="question">?</metamark>jovial</add></del> <add place="above" hand="#h02" seq="4"><metamark function="question">?</metamark>jocund</add></subst> heart yet beating in
     <lb/>my breast,</l>  
    
    <l><subst><del rend="overstrike" seq="1">The</del> <del rend="overstrike" hand="#h03" seq="3"><add place="above" hand="#h01" seq="2">My</add></del> <add place="below" hand="#h03" seq="4"><metamark function="add" target="#a003">&#8248;</metamark></add><add place="above" hand="#h03" seq="4" xml:id="a003">(The</add></subst>  body <add place="below" hand="#h03"><metamark function="add" target="#a004">&#8248;</metamark></add><del rend="overstrike" hand="#h03"><add place="above" rend="marked" hand="#h03" xml:id="a004">meantime</add></del> wreck'd, old, poor and paralyzed&#8212;<add place="above" hand="#h03">&#8212;the</add> <del rend="overstrike" hand="#h02"><subst><del rend="overstrike" hand="#h01" seq="1">the</del> <add place="above" hand="#h01" seq="2">of</add></subst></del>
           <lb/>strange inertias, <add place="above">deepening</add> <subst><del rend="overstrike" seq="1">like a pall&#11840;wrap</del> <add place="above" seq="2">falling pall&#11840;like</add></subst> round me;<add hand="#h03">)</add></l>
    
    <l>Of <add place="above" hand="#h02">The</add> burning fires <add place="below"><metamark function="add" target="#a005">&#8248;</metamark></add><add place="above" xml:id="a005">not yet <subst><del rend="overstrike" seq="1">exctinct</del> <add seq="2">down</add></subst></add> <add place="below" hand="#h03"><metamark function="question">?</metamark>down</add><del rend="overstrike">yet</del> in my sluggish blood,</l>
    
    <l><subst><del rend="overstrike" hand="#h02" seq="1">Of</del> <del rend="overstrike" hand="#h01" seq="3"><add place="above" hand="#h02" seq="2">The</add></del> <add place="below"><metamark function="add" target="#a006">&#8248;</metamark></add><add place="above" hand="#h01" seq="4" xml:id="a06">With</add></subst> undiminish'd faith&#8212;<subst><del rend="overstrike" hand="#h02" seq="1">of many a</del> <del rend="overstrike" hand="#h01" seq="3"><add place="above" hand="#h02" seq="2">&#8212;the groups of</add></del> <add place="above" hand="#h01" seq="4">and many a</add></subst> loving friend<add hand="#h02">s</add>.</l>
   </lg>
   <signed rend="underline">Walt Whitman</signed>
   <note type="authorial" place="bottom" hand="#h04">sent to Lippincotts</note>
   
   <note type="authorial" place="bottom" hand="#h03">Carols Closing Sixty-Nine</note>
   <pb xml:id="leaf001v" facs="uva.00158.002.jpg" type="verso"/>
   
   <note type="editorial" place="bottom" hand="#h05">Presented to <lb/>Dr Raley H Bell. <lb/>by Mary O Davis. <lb/>April 9th 1908.</note>
</body>
