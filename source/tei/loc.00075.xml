    <text type="manuscript">
        <body>
            <pb facs="loc_ew.00064.jpg" xml:id="leaf001r" type="recto"/>
            <lg type="poem">
                <head type="main" rend="underline">Certainties, Faith<lb/> Counterbalances, <lb/>Alternation</head>
                <lg type="linegroup">
                    <l>The body <add place="below"><metamark function="add" target="#a001">&#8248;</metamark></add><add place="above" xml:id="a001">sluggish,</add> old,</l>
                    <l>The <subst><del rend="overstrike" seq="1">fires in em</del> <add place="below" seq="2">embers left of earlierfires</add></subst></l>
                    
                    <l>The frozen winter clods&#8212;<subst><del rend="overstrike" seq="1">but</del> <add  place="above" seq="2">&#8212;to them the</add></subst> spring<lb/> shall come</l>
                    
                    <l><subst><del rend="overstrike" seq="1">And <unclear reason="illegible" cert="low" resp="#kmp">heads</unclear></del> <add place="above" seq="2">With grass</add></subst> and <del rend="overstrike">leaves</del> flowers and summer<lb/> <del rend="overstrike">branches green</del> fruits and corn</l>
                </lg>
                
                <lg type="linegroup">
                    <l>The sun <del rend="overstrike">is</del> <add place="below"><metamark function="add" target="#a002">&#8248;</metamark></add><add place="above" xml:id="a002"><add>now</add> sinking</add> low in the west <del rend="overstrike">de</del></l>
                    <l>Shall rise again to morning and to noon</l>
                    <l>The light in the eye grows dim&#8212;the<lb/> body <add place="above">blood all</add> sluggish, old</l>
                    <l>Appearances</l>
                </lg>
            </lg>
            <pb facs="loc_ew.00065.jpg" xml:id="leaf001v" type="verso"/>
        </body>
    </text>
