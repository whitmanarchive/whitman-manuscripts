   <pb xml:id="leaf001r" facs="uva.00084.001.jpg" type="recto"/>
   
   <p>I suppose <subst><del rend="overstrike" seq="1">there can be</del><del rend="overstrike" seq="3"><add place="above" seq="2">at this day</add></del><add place="above" seq="4">one can say</add></subst>
   nothing <del rend="overstrike"><add place="above"><gap extent="a few characters" reason="illegible"/></add></del> new <subst><del rend="overstrike" seq="1">offered</del><del rend="overstrike" seq="3"><add place="above" seq="2">said</add></del></subst> <add place="above">at this day</add> about
   Oriental Poetry&#8212;but <del rend="overstrike">I</del> will
   <subst><del rend="overstrike" seq="1">know there is no</del><add place="above" seq="2">there ever <del rend="overstrike" seq="3">come a <gap extent="one word" reason="illegible"></gap></del></add><add place="above" seq="4">be</add></subst>time
   or place&#8212;<del rend="overstrike">no</del> <add place="above">&#8212;<del rend ="overstrike">any</del><seg xml:id="alt001">every</seg><add place="above" xml:id="alt002">any</add><alt target="#alt001 #alt002"/></add> student, <del rend="overstrike">ambitious</del>
   <del rend="overstrike"><gap extent="two characters" reason="illegible"></gap> seeking <gap extent="a few characters" reason="illegible"></gap> achievement</del>
   <del rend="overstrike">in</del> of <del rend="overstrike">poet</del> <seg xml:id="tr001">the grand art</seg>
   <seg xml:id="tr002">seeking achievement<add place="below"><metamark target="#a001" function="add">&#8248;</metamark></add><add place="above" xml:id="a001" rend="marked"><subst><del rend="overstrike" seq="1">of</del><add place="above" seq="2">in</add></subst></add></seg><listTranspose>
    <transpose>
     <ptr target="#tr002"/>
     <ptr target="#tr001"/>
    </transpose>
   </listTranspose><del rend="overstrike"> worth
   mentioning</del>&#8212;<del rend="overstrike">without</del> when
   <subst><del rend="overstrike" seq="1">the</del><add place="above" seq="2">those</add></subst> old Asiatic <del rend="overstrike">poetic</del>
   bequests are not indispensable?
   ever <del rend="overstrike">an</del> be <add place="above">modern</add> student in the
   grand art, <add place="below"><metamark target="#a003" function="add">&#8248;</metamark></add><del rend="overstrike"><add place="above" xml:id="a003">(however modern)</add></del> to whom thy will
   not be more than all
   else in the garnerage
   of the past?</p>
