         <delSpan rend="hashmark" spanTo="#d1" hand="#h03"/>
         <lg>
            <head type="main" rend="underline">Go forth, ye twain.</head>
            <l>Go forth, ye <add hand="#h01" place="below"><metamark function="add" target="#a001">&#8248;</metamark></add><add hand="#h01" place="above" xml:id="a001">shadowy</add> twain! Go forth, my life!</l>
            <l>Go forth, my <add hand="#h02" place="below"><metamark function="add" target="#a002">&#8248;</metamark></add><add hand="#h02" place="above" xml:id="a002">book</add> 
               <subst>
                  <del rend="overstrike" seq="1">book</del> <del rend="overstrike" seq="3"><add place="above" seq="2"><note place="inline" type="authorial">?</note>songs</add></del></subst>! <subst><del rend="overstrike" seq="1">yo</del> <add place="above" seq="2">birth,</add></subst> youth, my<lb/>
               early life, connected seasons.</l>
               <l>
                  <add place="bottom" rend="marked">
                     <subst><del rend="overstrike" seq="1">A</del> <add place="above" seq="2"><subst><del rend="overstrike" seq="1">Haply</del> <add place="above" seq="2">Fitful</add></subst> as</add></subst> <del rend="overstrike" hand="#h02">twined</del> <add place="above" hand="#h02">tongues of</add> <del rend="overstrike" hand="#h02">inseperable</del> flame,&#8212;<add place="below" hand="#h02"><metamark function="add" target="#a003">&#8248;</metamark></add><add rend="marked" place="above" xml:id="a003">all twined <add hand="#h02" place="below"><metamark function="add" target="#a004">&#8248;</metamark></add><add hand="#h02" place="above" xml:id="a004">inseperable</add> &amp; merged in one</add> <del rend="overstrike" hand="#h01">many</del> <add hand="#h01" place="below"><metamark function="add" target="#a005">&#8248;</metamark></add><subst><del rend="overstrike" hand="#h02" seq="1"><add hand="#h01" place="above" xml:id="a005">in on</add></del> <add place="above" seq="2"><del rend="overstrike" hand="#h01"><add place="above">all</add></del> <del rend="overstrike" hand="#h02">merged a</del></add></subst></add>
               </l>
            <l>Mid-age&#8212;the war&#8212;the many problems, loves<lb/>
              thoughts <add place="above">of me&#8212;</add>&#8212;<add place="above" rend="marked">and with the rest</add> old age,</l>
            <l>Flicker<add place="above">ing</add> <del rend="overstrike">you<gap reason="illegible" extent="one or two characters"/> ho<gap reason="illegible" extent="one or two characters"/> th</del> to other <add place="below"><metamark function="add" target="#a006">&#8248;</metamark></add><add hand="#h01" place="above" xml:id="a006">seasons, problems,</add> <subst><del rend="overstrike" seq="1">lives &amp;</del> <add place="above" seq="2">ages,</add></subst> loves.</l>
         </lg>
