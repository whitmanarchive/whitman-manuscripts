 <text type="manuscript">
  <body>
   <pb xml:id="leaf001r" facs="loc_ew.00188.jpg" type="recto"/>
   <lg type="poem">
    <head rend="underline"><subst hand="#h02"><del rend="overstrike" seq="1">Go forth, ye <add place="below"><metamark function="add" target="#a001">&#8248;</metamark></add><add place="above" xml:id="a001">jocund</add> twain</del> <add place="above" seq="2">On, <subst><del rend="overstrike" seq="1">yet</del> <add place="above" seq="2">on</add></subst> awhile ye jocund twain</add></subst></head>
    <l><subst hand="#h02"><del rend="overstrike" seq="1">Go forth ye <del rend="overstrike" hand="#h01">fused and ending</del> <add place="inline" hand="#h01"><metamark function="add" target="#a002">&#8248;</metamark></add><add place="above" xml:id="a002" hand="#h01">jocund</add> twain</del> <add place="below" seq="2">On, <subst><del rend="overstrike" hand="h02" seq="1">yet</del> <add place="above" hand="h02" seq="2">on</add></subst> awhile ye jocund twain,</add></subst></l>
    
     <l><subst hand="h02">
      <add place="above" seq="2">My life and verse combining both and youth and varied mid-age years</add>
      <del rend="overstrike" seq="1">Go forth my life and <subst hand="#h01"><del seq="1">book</del> <del rend="overstrike" seq="3"><add place="above" seq="2">song</add></del> <add place="above" seq="4">verse</add></subst>! my birth<del rend="overstrike">,</del> and<lb/> 
      youth, early <add place="below"><metamark function="add" target="#a003">&#8248;</metamark></add><add place="above" xml:id="a003"><subst><del rend="overstrike" seq="1">mid-aged</del> 
        <del rend="overstrike"><add place="above" seq="2">the many</add></del></subst> varied mid-aged</add> years</del></subst></l>
    
     <l>Fitful as tongues of flame, iseparably twined<lb/>
           and merged as one;</l>
    <l><subst><del rend="overstrike" seq="1">The</del><del rend="overstrike" seq="3"><add place="above" seq="2">My</add></del><del rend="overstrike" seq="5"><add place="above" seq="4">is</add></del><add place="above" seq="6">My</add></subst> single soul&#8212;<del rend="overstrike" seq="2"><add place="above" seq="1">joys</add></del>aims<add place="above" hand="h02">?</add>, <subst><del rend="overstrike" seq="1">pangs</del><add place="above" seq="2">confirmations,</add></subst> lights&#8212;nor single<lb/>
           soul alone,</l>
    
    <l>
     <subst hand="#h01"><del rend="overstrike" seq="1">The</del><del rend="overstrike" seq="5">
      <add place="above" seq="4"><note type="authorial" place="inline">?</note>My</add></del>
      <del rend="overstrike" seq="3"><add place="above" seq="2"><note type="authorial" place="inline">?</note>A</add></del> 
      <add place="above" seq="6">My</add></subst> single soul&#8212;<del rend="overstrike"><add place="above">joys,</add></del><note type="authorial" place="inline">?</note>aims<add place="above" hand="#h02"><note type="authorial">?</note></add>, <subst><del rend="overstrike" seq="1">purp</del> <add place="above" seq="2">confirmations</add></subst> lights&#8212;nor single<lb/> soul alone,
    </l>
    
    <l>
     <subst hand="#h01"><del rend="overstrike" seq="1">A</del>
      <add place="above" seq="2"><del rend="overstrike"><note type="authorial" place="inline">?</note></del>My</add>
      </subst> nation's crucial time <add place="above">age</add> <add place="below">strain</add><add place="below"><metamark function="add" target="#a004">&#8248;</metamark></add><add place="above" xml:id="a004">(<subst><del rend="overstrike" seq="1">perhaps</del> <add place="above" seq="2">America's, haply</add></subst> humanity's,)</add>&#8212;its trial great and<lb/>
           victory great;</l>
    
    <l>
     <add place="below"><metamark function="add" target="#a015">&#8248;</metamark></add><add place="above" rend="marked" xml:id="a015"><del rend="overstrike" hand="h02">I chant</del> <subst rend="overwrite" hand="h02"><del>i</del><add>I</add></subst>n it,</add> To-day's <hi rend="underline"><choice><sic>eclairecissement</sic><corr>éclaircissement</corr></choice></hi> of all 
     <add place="below" hand="#h01"><metamark function="add" target="#a005">&#8248;</metamark></add><del rend="overstrike" hand="h02"><add place="above" xml:id="a005">the races,</add></del> the past, 
     <add place="below"><metamark function="add" target="#a006">&#8248;</metamark></add><del rend="overstrike" seq="2"><add place="above" xml:id="a006" seq="1">its race</add></del><add place="above" seq="3">the <subst><del rend="overstrike" seq="1">old</del> <del rend="overstrike" seq="3"><add place="above" seq="2">the</add></del> <add place="above" seq="4">eastern</add></subst> world,</add> all<lb/> lands&#8212;<del rend="overstrike">America</del></l>
    
    <l>Here <subst><del rend="overstrike" seq="1"><unclear reason="illegible" resp="#bb" cert="medium">for</unclear></del> <add place="above" seq="2">from</add></subst>
     <subst><del rend="overstrike" seq="1">its</del> <add place="above" seq="2">their</add></subst> wanderings (<subst hand="h02"><del rend="overstrike" seq="1"><unclear reason="illegible" resp="#bb" cert="medium">even</unclear></del><add place="above" seq="2">e'en</add></subst> <del rend="overstrike">its</del> strayings) strifes <del rend="overstrike">and</del> aims, <add place="above" hand="h02">lessons <note type="authorial">?</note></add> wars&#8212;here <add place="below"><metamark function="add" target="#a016">&#8248;</metamark></add><add hand="#h01" place="above" xml:id="a016"><subst hand="#h02"><del rend="overstrike">in</del> <del rend="overstrike" seq="3"><add place="above" seq="2">for</add></del> <add place="above" seq="4">in</add></subst> the west <add place="inline">at last,</add></add> triumphant</l>
    
    <l>A gladsome <add hand="#h01" place="below"><metamark function="add" target="#a017">&#8248;</metamark></add><add hand="#h01" place="above" xml:id="a017">pealing</add> cry&#8212;a song of hope <add place="above" hand="h02"><note type="authorial">?</note>pride</add> and <subst><del rend="overstrike" seq="1">growth</del> <add place="abpve" seq="2">satisfaction</add></subst></l>
    
    <l>I chant <add place="inline"><metamark function="add" target="#a007">&#8248;</metamark></add><add place="above" xml:id="a007">the bulk</add> the common average, <del rend="overstrike">neither</del> <add place="below"><metamark function="add" target="#a009">&#8248;</metamark></add><del rend="overstrike"><add place="above" xml:id="a009">the bulk</add></del> the best<lb/><del rend="overstrike">nor worst</del> no sooner than the worst&#8212;<add place="below"><metamark function="add" target="#a008">&#8248;</metamark></add><add place="above" xml:id="a008">&#8212;I chant of age,</add> <del rend="overstrike">the old,</del></l>
    
    <l>(My verses, made in early life and through mid <subst><del rend="overstrike" seq="1">age</del> <add place="above" seq="2">span</add></subst>,</l>
    
    <l>I <subst><del rend="overstrike" seq="1">launch to</del> <add place="above" seq="2">keep for</add></subst> snow-white hairs <add place="below" hand="h02"><metamark function="add" target="#a010">&#8248;</metamark></add><add place="above" hand="h02" rend="marked" xml:id="a010">yet the same</add> and pulses cool'd<lb/>
     <del rend="overstrike" hand="h02">just just</del> the same;)</l>
    
    <l><subst hand="#h02"><del rend="overstrike" seq="1">Of</del> <add place="above" seq="2">Through</add></subst> peace and war <add place="below"><metamark function="add" target="#a011">&#8248;</metamark></add><add place="above" xml:id="a011">ye twain&#8212;</add>&#8212;<del rend="overstrike" hand="h02">of</del> <add place="below" hand="h02"><metamark function="add" target="#a012">&#8248;</metamark></add><add place="above" hand="h02" rend="marked" xml:id="a012">through</add> many problems, curious idle<lb/>
     meditations&#8212;and now <add hand="#h01" place="below"><metamark function="add" target="#a018">&#8248;</metamark></add><del rend="overstrike"><add place="above" xml:id="a018">with love,</add></del> old age of me <add place="below"><metamark function="add" target="#a013">&#8248;</metamark></add><add place="above" xml:id="a013">with love,</add></l>
    
    <l><subst><del rend="overstrike" seq="1">Flickering</del> <add place="above" seq="2">Wafted</add></subst> to <subst><del rend="overstrike" hand="#h01" seq="1">other</del> <del rend="overstrike" hand="h02" seq="3"><add place="above" hand="#h01" seq="2">later</add></del></subst> <add place="below" hand="h02"><metamark function="add" target="#a014">&#8248;</metamark></add><add place="above" xml:id="a014" hand="#h02"><subst><del rend="overstrike" hand="h02" seq="1">ending</del> <add place="above" hand="h02" seq="2">finishing</add></subst> stages, stages, <del rend="overstrike" hand="h02" seq="4">lore, light,</del></add> <subst hand="#h02"><del rend="overstrike" seq="1">seasons, problems,</del> <add place="above" seq="2">changes,</add></subst> <subst hand="#h01"><del rend="overstrike" seq="1">ages.</del> <add place="above" seq="2">just the same.</add></subst></l>
   </lg>
   <signed>Walt Whitman</signed>
