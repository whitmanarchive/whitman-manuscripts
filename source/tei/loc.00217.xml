   <pb xml:id="leaf001r" facs="loc_ew.00104.jpg" type="recto"/>
   
   <lg type="poem">
    <head type="main"><add place="above">? To</add> <hi rend="underline">My Seventieth year</hi></head>
    
    <l>Approaching <add place="below"><metamark function="add" target="#a001">&#8248;</metamark></add><subst><del rend="overstrike" seq="2"><add place="above" xml:id="a001" seq="1">near at hand.</add></del> <add place="above" seq="3">nearing</add></subst> curious, <del rend="overstrike"><add place="above"><del rend="overstrike"><add place="above">so</add></del> close</add></del> <del rend="overstrike">dim</del></l>
    <l><subst><del rend="overstrike" seq="1">As some</del> <add place="above" seq="2">Thou dim</add></subst> half-visible <del rend="overstrike">hovering</del> <del rend="overstrike"><add place="above">closing</add></del> spectre, <add place="below"><metamark function="add" target="#a002">&#8248;</metamark></add><add place="above" xml:id="a002" rend="marked">hovering close&#8212;</add><lb/>
     <subst><del rend="overstrike" seq="1">bearing woe <unclear reason="illegible" cert="low" resp="#tb">e weal</unclear></del> <add place="above" seq="2">&#8212; bring'st thou</add></subst> <del rend="overstrike">joy <del rend="overstrike"><add place="above">or</add></del> or woe?</del><lb/> me life or death?</l>
    <l><subst><del rend="overstrike" seq="1">Or life or death</del> <add place="above" seq="2">Strength, weakness</add></subst></l>
    <l>Or more paralysis <add place="below"><metamark function="add" target="#a003">&#8248;</metamark></add><add place="above" xml:id="a003">weight</add> and heavier</l>
    <l>Blindness</l>
    <l>An unnerv'd hand and <subst><del rend="overstrike" seq="1">voice</del> <add place="above" seq="2">accent</add></subst>&#8212;<subst><del rend="overstrike" seq="1">a</del><add place="above" seq="2">&#8212;</add></subst> buried heart<lb/>
               and brain</l>
    <l><del rend="overstrike">Or wreaths from foreign lands</del></l>
    <l>Or bitter tears</l>
    <l>Or placid skies and sun, <del rend="overstrike"><gap reason="illegible" extent="one character"/></del> or wreaths from<lb/>
               foreign lands</l>
    <l><subst><del rend="overstrike" seq="1">Or</del> <del rend="overstrike" seq="3"><add place="above" seq="2">The</add></del> <add place="above" seq="4">A</add></subst> summary end of all&#8212;to pass me to<lb/>
                                     another year</l>
    <l>Thro' thy twelve months</l>
   </lg>
   
