      <body>
         <pb facs="loc_ew.00033.jpg" xml:id="leaf001r" type="recto"/>
         <lg type="linegroup">
               <l xml:id="tr01">(Here fretful, parrot-like and old,<lb/> harping and <subst><del rend="overstrike" seq="1">harping</del> <add place="above" seq="2">screeching</add></subst>)</l>
            <l xml:id="tr02">Wilt cut me short, <add place="below"><metamark function="add" target="#a001">&#8248;</metamark></add><add place="above" xml:id="a001">for good</add> or leave<lb/> me here repeating?</l><listTranspose>
               <transpose>
                  <ptr target="#tr02"/>
                  <ptr target="#tr01"/>
               </transpose>
            </listTranspose>
            <l>Wilt stir the waters yet</l>
               <l>Steep me in immobility</l>
               <l>As we grow old we narrow on<lb/> ourselves concentrating</l>
               <l>Something <add place="above">to us</add> unspeakably pensive in<lb/> our <subst><del rend="overstrike" seq="1">luck</del> <add place="above" seq="2">own age</add></subst>, our sorrows&#8212;</l>
         </lg>
         
         <note type="archival" place="bottom" hand="#h02">297&#8212;<unclear reason="illegible" cert="low" resp="#js">Doubeday</unclear> Queries to 70th Year</note>
         
         <pb facs="loc_ew.00034.jpg" xml:id="leaf001v" type="verso"/>
