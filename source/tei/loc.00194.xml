      <body>
         <pb facs="loc_ew.00070.jpg" xml:id="leaf001r" type="recto"/>
               <lg type="linegroup">
                  <l>Each claim <add hand="#h01" place="below"><metamark function="add" target="#a001">&#8248;</metamark></add><add hand="#h01" place="above" xml:id="a001">ideal,</add> line, <subst><del rend="overstrike" seq="1">tenet</del> <del rend="overstrike"><add place="above" seq="2">aspiration,</add></del></subst> by all <del rend="overstrike">the</del> <add place="above">ideals </add><add place="above">lines, claims</add>  
                     <lb/><del rend="overstrike">rest</del> temper'd</l>
                  <l>Each right and wish by other wishes, rights</l>
               </lg>
         
               <lg type="linegroup">
                  <l>Not to exclude or take away, <add place="above">or <subst><del rend="overstrike" seq="1">point</del> <add place="above" seq="2">pick</add></subst> out evils</add> <add hand="#h02" place="below"><metamark function="add" target="#a002">&#8248;</metamark></add><add hand="#h02" place="above" rend="marked" xml:id="a002">from their vast formidable masses</add></l>
                  
                  <l>But add, <del rend="overstrike"><add place="above">and</add></del> extend, complete, proportionate <add hand="#h02" place="below"><metamark function="add" target="#a003">&#8248;</metamark></add><add hand="#h02" place="above" xml:id="a003">the immortal good,</add>&#8212;<del rend="overstrike">and</del> <lb/><del rend="overstrike">to develop heroism.</del></l>               </lg>
         
                 <metamark function="question">?</metamark>
               <lg type="linegroup">
                  <l>For <add hand="#h01" place="below"><metamark function="add" target="#a004">&#8248;</metamark></add><add hand="#h01" place="above" xml:id="a004">out door</add> health, the land and sea, <add hand="#h01" place="below"><metamark function="add" target="#a005">&#8248;</metamark></add><add hand="#h01" place="above" xml:id="a005">bar</add> <subst><del rend="overstrike" seq="1">friendship</del> <add place="above" seq="2">good will,</add></subst></l>
                  
                  <l>For America<subst><del rend="overstrike" seq="1">,</del><add place="above" seq="2">&#8212;</add></subst>for <subst><del rend="overstrike" seq="1">all</del> <add place="above" seq="2">common people,</add></subst> all <subst><del rend="overstrike" seq="1">lands,</del> <add place="above" seq="2">lands,</add></subst> all the earth</l>
                  <l><add place="inline" hand="#h02">(Not one nation only&#8212;not even America only)</add></l></lg>
         
         <metamark function="question">?</metamark>
                           <lg type="linegroup">
                  <head type="main-authorial" rend="underline">These pages past</head>
                  <l>Thoughts, <add hand="#h01" place="below"><metamark function="add" target="#a006">&#8248;</metamark></add><add hand="#h01" place="above" xml:id="a006">suggestions,</add> aspirations, pictures</l>
                  <l>Cities and farms&#8212;<subst><del rend="overstrike" seq="1">of</del> <add place="above" seq="1">by</add></subst> day and night&#8212;<subst><del rend="overstrike" seq="1">of</del> <add place="above" seq="2">thro'</add></subst> peace and war</l>
                  <l><add place="inline" hand="#h02">Thro' platitudes&#8212;thro' commonplace.</add></l>
               </lg>
               <lg type="linegroup">
                  <l>I sing of life, yet mind me well of death,</l>
                  <l>(To-day Death dogs <subst><del rend="overstrike" seq="1">my</del> <del rend="overstrike" seq="3"><add place="above" seq="2"><gap reason="illegible" extent="one or two characters"/></add></del></subst> my steps <add hand="#h01" place="below"><metamark function="add" target="#a007">&#8248;</metamark></add><add hand="#h01" place="above" xml:id="a007">and has for years&#8212;</add> my seated <subst><del rend="overstrike" seq="1">form</del> <add place="above" seq="2">shape</add></subst> <add hand="#h02" place="below"><metamark function="add" target="#a008">&#8248;</metamark></add><add hand="#h02" place="above" xml:id="a008">as here&#8212;</add></l>
                  <l><del rend="overstrike">And has, for years&#8212;)</del>&#8212;<add hand="#h02" place="below"><metamark function="add" target="#a009">&#8248;</metamark></add><add hand="#h02" place="above" xml:id="a009">Death,</add> silent, <del rend="overstrike">invisible</del> draws <lb/>sometimes close <subst rend="overwrite" hand="#h01"><del>)</del><add>&#8212;</add></subst> as face to face.)</l>
               </lg>
         <pb facs="loc_gk.00004_large.jpg" type="verso" xml:id="leaf001v"/>
