      <body>
         <pb facs="nyp.00053.001_large.jpg" xml:id="leaf001r" type="recto"/>
         <lg
              >
            <note place="top"
                  type="authorial">? A laurel wreath</note>
            <head type="main-authorial" rend="underline">
               <subst>
                  <rdg varSeq="1">
                     <del rend="overstrike">Laurels and Palms.</del> 
                  </rdg>
                  <rdg varSeq="2">
                     <del rend="overstrike">
                        <add place="supralinear" rend="unmarked">Laurels and Wreaths</add>
                     </del> 
                  </rdg>
                  <rdg varSeq="3">
                     <del rend="overstrike">
                        <add place="supralinear" rend="unmarked">To those who<add place="supralinear" rend="unmarked">'ve</add> fail'd</add>
                     </del> 
                  </rdg>
                  <rdg varSeq="4">
                     <del rend="overstrike">
                        <add place="supralinear" rend="unmarked">Palm-wraiths</add>
                     </del> 
                  </rdg>
                  <rdg varSeq="5">
                     <add place="infralinear" rend="unmarked">To those who've fail'd</add>
                  </rdg>
               </subst>
            </head>
            <note place="left"
                  type="authorial"
                  rend="circled">Sent to Herald April 21</note>
            <del rend="hashmark">
               <note place="right"
                     type="authorial">? I believe (but am not sure) pub in <hi rend="underline">Herald</hi> late in Jan '88</note>
            </del>
            <l>To those who<add place="supralinear" rend="unmarked">'ve</add> fail'd, <add place="inline" rend="unmarked">in aspiration <subst>
                     <rdg varSeq="1">
                        <del rend="overstrike">great</del>
                     </rdg>
                     <rdg varSeq="2">
                        <add place="supralinear" rend="unmarked">vast</add>
                     </rdg>
                  </subst>,</add>
            </l>
            <l>
               To unnam'd soldiers fallen in front,<lb/>
               on the lead,<lb/>
            </l>
            <l>
               To calm, devoted engineers <add place="supralinear" rend="insertion">—to over‑ardent travelers—</add>—<add place="supralinear" rend="unmarked">—to</add> pilots on<lb/>
               their ships,<lb/>
            </l>
            <l>
               <subst>
                  <rdg varSeq="1">
                     <del rend="overstrike">Poets and poems</del>
                  </rdg>
                  <rdg varSeq="2">
                     <add place="supralinear" rend="unmarked">To <add place="supralinear" rend="insertion">
                           <del rend="overstrike">many a</del> 
                           <add place="supralinear" rend="unmarked">every <del rend="overstrike">s</del>
                           </add>
                        </add> song<del rend="overstrike">s</del> and pictures</add> 
                  </rdg>
               </subst>without <subst>
                  <rdg varSeq="1">
                     <del rend="overstrike">parturition</del> 
                  </rdg>
                  <rdg varSeq="2">
                     <add place="supralinear" rend="unmarked">
                        <unclear reason="illegible" cert="medium" resp="#cf">recognition</unclear>
                     </add> 
                  </rdg>
               </subst>;<add place="supralinear" rend="insertion">—<add place="supralinear" rend="insertion">I'd rear</add> a <subst>
                     <rdg varSeq="1">
                        <del rend="overstrike">laurel'd</del> 
                     </rdg>
                     <rdg varSeq="2">
                        <add place="supralinear" rend="unmarked">laurel‑cover'd</add> 
                     </rdg>
                  </subst>monument</add>
            </l>
            <l>
               <add place="supralinear" rend="insertion">High, high above the rest—</add>To all, cut off before their time,</l>
            <l>Possess'd by some great spirit of fire,</l>
            <l>Quench'd by an early death.</l>
            <closer>
               <signed>Walt Whitman</signed>
            </closer>
            <note place="bottom"
                  type="authorial"
                  rend="circled">put in Herald</note>
         </lg>
         <pb facs="nyp.00053.002_large.jpg" xml:id="leaf001v" type="verso"/>
