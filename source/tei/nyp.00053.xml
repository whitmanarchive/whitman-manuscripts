      <body>
         <pb facs="nyp.00053.001_large.jpg" xml:id="leaf001r" type="recto"/>
         <note place="left" type="authorial" rend="circled">Sent to Herald April 21</note>
         <note place="right" type="authorial"><del rend="overstrike">? I believe (but am not sure) pub in <hi rend="underline">Herald</hi> late in Jan '88</del></note>
         <lg type="poem">
            
               <delSpan hand="#h01" rend="hashmark" spanTo="#d001"/>
            <head type="main">
                     <del rend="overstrike" hand="#h02"><hi rend="underline">Laurels and Palms.</hi></del> 
                     <add place="above" hand="#h03">Laurels and Wreaths</add> 
                     <del rend="overstrike" hand="#h03"><add place="above" hand="#h02">To those who<add place="above">'ve</add> fail'd</add></del> 
               <del rend="overstrike" hand="#h03"><add place="above" hand="#h02"><metamark function="question">?</metamark>Palm&#11840;wraiths</add></del>
               <add place="above" hand="#h04"><metamark function="question">?</metamark>A laurel wreath</add>
            </head>
               <anchor xml:id="d001"/> 
              <head type="main"><add rend="underline" hand="#h01">To those who've fail'd</add></head>
            
            <l>To those who<add place="above" hand="#h02">'ve</add> fail'd, <add hand="#h02">in aspiration <subst hand="#h02"><del rend="overstrike" seq="1">great</del> <add place="above" seq="2">vast</add></subst>,</add>
            </l>
            <l>To unnam'd soldiers fallen in front,<lb/>
               on the lead,<lb/>
            </l>
            <l>
               To calm, devoted engineers <add hand="#h01" place="below"><metamark function="add" target="#a001">&#8248;</metamark></add><add hand="#h01" place="above" xml:id="a001">&#8212;to over&#11840;ardent travelers&#8212;</add>—<add place="above">&#8212;to</add> pilots on<lb/>
               their ships,<lb/>
            </l>
            <l><subst><del rend="overstrike" hand="#h02" seq="1">Poets and</del> <add place="above" hand="#h02" seq="2">To <add hand="#h01" place="below"><metamark function="add" target="#a002">&#8248;</metamark></add><add hand="#h01" place="above" xml:id="a002"><subst hand="#h03"><del rend="overstrike" seq="1">many a</del> <add place="above" seq="2">every <del rend="overstrike">s</del></add></subst></add> song<del rend="overstrike" hand="#h01">s</del> and</add></subst> <subst hand="#h02"><del rend="overstrike" seq="1">poems</del> <add place="above" seq="2">picture<del rend="overstrike" hand="#h01">s</del></add></subst> without <subst hand="#h03">
                     <del rend="overstrike" seq="1">parturition</del> 
                     <add place="above" seq="2">recognition</add></subst><add hand="#h02" place="below"><metamark function="add" target="#a003">&#8248;</metamark></add><add hand="#h02" place="above" rend="marked" xml:id="a003">&#8212;<add hand="#h01" place="below"><metamark function="add" target="#a004">&#8248;</metamark></add><add hand="#h01" place="above" xml:id="a004">I'd rear</add> a <subst><del rend="overstrike" seq="1">laurel'd</del> <add place="above" seq="2">laurel&#11840;cover'd</add></subst> monument</add>;</l>
            <l>
               <add hand="#h02" place="below"><metamark function="add" target="#a005">&#8248;</metamark></add><add place="above" xml:id="a005">High, high above the rest&#8212;</add>To all, cut off before their time,</l>
            <l>Possess'd by some great spirit of fire,</l>
            <l>Quench'd by an early death.</l>
               <signed rend="right">Walt Whitman</signed>
         </lg>
         <note place="bottom" type="authorial" rend="circled" hand="#h02">put in Herald</note>
         <pb facs="nyp.00053.002_large.jpg" xml:id="leaf001v" type="verso"/>
         <note type="archival" hand="#h05" place="center">NYPL</note>
