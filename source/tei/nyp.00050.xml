      <body>
         <pb facs="nyp.0050.001.jpg" xml:id="leaf001r" type="recto"/>
         <note place="top" type="authorial" rend="circled" hand="#h02">black</note>
         <note place="top" type="collaborative" rend="circled" hand="#h03">piece by itself</note>
         <note place="top" type="authorial" rend="circled"><del rend="overstrike">finished version</del></note>
         <lg type="poem">
            <head type="main" rend="underline">You lingering sparse leaves of me.</head>
            <l>You lingering sparse leaves of me on<lb/>
               bare December boughs,</l>
            <l>And I some well&#11840;shorn tree of field<lb/>
               or orchard row;</l>
            <l>You tokens 
               <subst><del rend="overstrike" seq="1" hand="#h01">late</del> <!----> 
                  <del rend="overstrike" hand="#h02" seq="3"><add hand="#h01" place="above" seq="2">old</add></del> 
                  <del rend="overstrike" hand="#h02" seq="5"><add place="above" hand="#h02" seq="4">different</add></del>
                  <del rend="overstrike" hand="#h02" seq="7"><add place="above" hand="#h02" seq="6">meagre</add></del>
                  <add hand="#h02" place="below" seq="2"><metamark function="add" target="#a001">&#8248;</metamark></add>
                  <add hand="#h02" place="above" seq="8" xml:id="a001">diminute</add>
               </subst> and lorn&#8212;(<subst><del rend="overstrike" seq="1">no more</del>
                  <add place="above" seq="2">not now</add></subst><lb/>
               the verdant May's,&#8212;<add hand="#h01" place="below"><metamark function="add" target="#a002">&#8248;</metamark></add><add hand="#h01" place="above" xml:id="a002" rend="marked"><subst><del rend="overstrike" seq="1" hand="#h01">no<add hand="#h02">r</add></del> <add place="above" seq="2">or</add></subst>
                  July clover bloom,</add>
                <del rend="overstrike" hand="#h02">nor crops</del><lb/>
                  <del rend="overstrike" hand="#h01"><add place="inline" hand="#h02">n</add></del>or <add place="above" hand="#h02">&#8212;no</add> fruits of August now;)</l>
            <l>You <subst hand="#h02"><del rend="overstrike" seq="1">meagre</del> <add place="above" seq="2">pallid</add></subst> 
               little banners<add hand="#h02">,</add> <del rend="overstrike" hand="#h02">flaunted</del><lb/>
               <subst><del rend="overstrike" hand="#h02" seq="1">to the air</del> <add hand="#h01" place="below"><metamark function="add" target="#a003">&#8248;</metamark></add><del rend="overstrike" seq="3" hand="#h02"><add place="above" seq="2" xml:id="a003">flaunting yet&#8212;</add></del></subst>&#8212;<del rend="overstrike">you</del> remnants valueless&#8212;<lb/>
               you overstay'd of time;</l>
            <l>Yet dear, soul dear, <subst hand="#h02"><del rend="overstrike" seq="1">diminute</del> <add place="above" seq="2">continued</add></subst> leaves,<lb/>
               my hardiest and my last.</l>
               <signed rend="doubleUnderline">Walt Whitman</signed>
         </lg>
         <pb facs="nyp.0050.002.jpg" xml:id="leaf001v" type="verso"/>
