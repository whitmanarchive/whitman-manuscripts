 <pb facs="loc_ew.00069.jpg" xml:id="leaf001r" type="recto"/>
<lg type="poem">
<head type="main" rend="underline">Down, down, proud gorge</head>
<l>Down, down, proud gorge, tho' choking thee!</l>
 
<l>Thy haughty <add place="above">high-borne <add rend="marked" place="below">rebellious</add>
</add> forehead to the gutter,</l>
 
 <l><subst><del rend="overstrike" seq="1">Thy</del> <add place="below" seq="2"><metamark function="add" target="#a001">&#8248;</metamark></add><add place="above" seq="2" xml:id="a001">Crouch, crouch thy</add></subst> neck to eleemosynary <note type="authorial" place="above">?</note> gifts</l>
</lg>
 
<lg type="poem">
<head type="main" rend="underline">
<subst><del rend="overstrike" seq="1">Is't indeed</del> <add place="above" seq="2">Are they</add></subst> <subst><del rend="overstrike" seq="1">thy</del> <del rend="overstrike" seq="3"> <add place="above" seq="2">my</add></del></subst> last words?</head>
 
<l>No, <add hand="#h01" place="below"><metamark function="add" target="#a002">&#8248;</metamark></add><add hand="#h01" place="above" xml:id="a002">I have</add> many <del rend="overstrike"><hi rend="underline">are left</hi></del></l>
 
<l>Bitter <del rend="overstrike">and flaming</del></l>
 
<l>Scarifying devouring flam<subst rend="overwrite"><del>s</del><add>es</add></subst>, <add hand="#h02">O year</add></l>
 
<l xml:id="tr001">Shot in chest yet left</l>
 
<l><seg xml:id="tr002">Have <add place="above">not</add> fought
<add hand="#h01" place="below"><metamark function="add" target="#a003">&#8248;</metamark></add><add hand="#h01" place="above" xml:id="a003">out</add> my battle <add place="above">yet</add>&#8212;</seg>
<listTranspose>
 <transpose>
  <ptr target="#tr002"/>
  <ptr target="#tr001"/>
 </transpose>
</listTranspose> fought my best steadily,<lb/> warily</l>
<l>Thy silliness, scorn, thy <add hand="#h01" place="below"><metamark function="add" target="#a004">&#8248;</metamark></add><add hand="#h01" place="above" xml:id="a004">affectations</add> lisps, thy income,</l>
<l>Have I said all <add hand="#h02">yet</add><add place="above" hand="#h01">?</add> <add place="above" hand="#h02">O year</add> world?</l>
</lg>
 <pb facs="loc_gk.00002.jpg" xml:id="leaf001v" type="verso"/>
