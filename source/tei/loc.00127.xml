    <text>
        <body>
          <pb facs="loc_ew.00058.jpg" xml:id="leaf001r" type="recto"/>
            <lg type="poem">
                <lg type="linegroup">
                <l>Hints arousals interrogations</l>
                <l>Time's last accumulation<lb/>
                    and result&#8212;earth's <hi rend="underline">final&#232;</hi></l>
                <l>The common average<lb/>
                    (neither best nor worst) the old,</l>
                <l xml:id="tr01">The great eclairecissement of<lb/>
                    all the past, all lands,<lb/>
                    America</l> 
                <l xml:id="tr02">(<subst><del rend="overstrike" seq="1">There</del> <add place="above" seq="2">My</add></subst> verses<add place="above"><metamark function="question">?</metamark></add> made in early<lb/>
                    life and through mid-age</l>
                <l xml:id="tr03">I <subst><del rend="overstrike" seq="1">give</del> <add place="above" seq="2">keep</add></subst> <del rend="overstrike">out</del> for <add place="below"><metamark function="add" target="#a001">&#8248;</metamark></add><add place="above" xml:id="a001">snow</add> white hairs and<lb/>
                    <del rend="overstrike">th</del> pulses cool'd, just, just the<lb/>
                    same;)</l>
                    <listTranspose>
                        <transpose>
                            <ptr target="#tr02"/>
                            <ptr target="#tr03"/>
                            <ptr target="#tr01"/>
                        </transpose>
                    </listTranspose>
                </lg>
                <lg>
                <l>A gladsome cry<lb/>
                    <subst><del rend="overstrike" seq="1">the</del> <add place="above" seq="2">a</add></subst> song of hope and growth</l>
                </lg>
                <pb facs="loc_ew.00059.jpg" xml:id="leaf001v" type="verso"/> 
            </lg>
        </body>
    </text>
