    <text type="manuscript">
        <body>
            <pb facs="bos_bb.00003.jpg" xml:id="leaf001r" type="recto"/>
            <note type="archival" rend="underline" place="top" hand="#h01"><unclear reason="illegible" resp="#bb" cert="medium">p</unclear>tx</note>
            <lg type="poem">
                <head type="main" rend="underline">Sail <subst><del rend="overstrike" seq="1">forth <metamark function="question">?</metamark></del> <add rend="unmarked" place="above" seq="2">out</add></subst> <add place="above">for good <metamark function="question">?</metamark> for aye,</add> O mystic yacht<subst><add seq="2">!</add> <del rend="overstrike" seq="1">of me</del></subst></head>
                <l>Heave the anchor short,</l>
                <l>Raise main-sail and jib&#8212;steer <subst><del rend="overstrike" seq="1">out,</del> <add place="above" seq="2">forth, <add rend="unmarked" place="above"><metamark function="question">?</metamark> for aye</add></add></subst></l>
                <l>O little white-hull'd sloop,<del rend="overstrike">&#8212;</del>now <subst><del rend="overstrike" seq="1">for the</del> <del rend="overstrike" seq="3"><add place="above" seq="2">truly to</add></del> <add rend="unmarked" place="above" seq="4"><metamark function="question">?</metamark> speed <del rend="overstrike" seq="5">take</del> me</add></subst> <add place="above"><subst><del rend="overstrike" seq="1">truly</del> <add place="above" seq="2">really</add></subst></add>
                    <lb/><subst><add place="below" seq="1">on</add> <del rend="overstrike" seq="3"><add place="above" seq="2">to</add></del></subst> deep waters</l>
                <l><del rend="overstrike">Now, now to thy divinest venture</del></l>
                <l>(I will not call it <subst><del rend="overstrike" seq="1">my</del> <add place="above" seq="2">our</add></subst> concluding voyage,</l>
                <gap reason="illegible" extent="at least one line"/>
                <milestone unit="glued"/>
                <l>But outset and sure entrance to the truest,
                    <lb/>best, maturest,)</l>
                <l><del rend="overstrike">In perfect faith</del>—Depart <add place="below"><metamark function="add" target="#a001">&#8248;</metamark></add><del rend="overstrike"><add place="above" xml:id="a001">&#8212;for good!</add></del>! <add place="below"><metamark function="add" target="#a002">&#8248;</metamark></add><add place="above" xml:id="a002">depart <add hand="#h02">from <add hand="#h01" place="above"><metamark function="question">?</metamark> solid</add> earth&#8212;</add></add>—<del rend="overstrike" hand="#h02"><add place="below" hand="#h02"><metamark function="add">&#8248;</metamark></add></del>no more returning
                    <lb/>to these shores,</l>
                
                <l>Now, <subst><add place="below" seq="2"><metamark function="add" target="#a003">&#8248;</metamark></add><add place="above" xml:id="a003" seq="2">henceforth</add> <del rend="overstrike" seq="1">now,</del></subst> <subst><del rend="overstrike" seq="1">for good, upon</del> <add place="above" seq="2">starting on</add></subst> <subst><del rend="overstrike" seq="1">thy</del> <add place="above" seq="2">our</add></subst> <del rend="overstrike">great</del> <subst><del rend="overstrike" seq="1">divinest</del> <add place="above" seq="2"><del rend="overstrike" seq="3"><metamark function="question">?</metamark></del> infinite</add></subst>
                    <lb/>venture<add hand="#h02">, <subst><del rend="overstrike" seq="1">sail!</del> <del rend="overstrike" seq="3"><add place="above" seq="2">sailing,</add></del></subst></add>  <del rend="overstrike" hand="#h01"><add hand="#h02">starting,</add></del></l>
                <l>Spurning all yet known ports, seas, <choice><orig>grav-<lb/>itation</orig><reg>gravitation<lb/></reg></choice>
                    </l>
                <l>Sail <subst><del rend="overstrike" seq="1">forth</del> <add place="above" seq="2">out</add></subst>, <add place="below"><metamark function="add" target="#a004">&#8248;</metamark></add><add place="above" xml:id="a004"><subst><del rend="overstrike" seq="1">in perfect faith</del> <add place="below" rend="marked" seq="2">for good</add></subst></add> <add place="above">for aye</add> O mystic yacht of me.</l></lg>
            <pb facs="bos_bb.00004.jpg" xml:id="leaf001v" type="verso"/>
            <note type="editorial" place="top" hand="#h03">Good bye My Fancy <lb/>Sail Out for Good Etc <lb/>Page 7&#8212;Good Bye My Fancy</note>
        </body>
    </text>
