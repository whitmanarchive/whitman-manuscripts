    <text type="manuscript">
        <body>
            <pb facs="yal.00007.001.jpg" xml:id="leaf001r" type="recto"/>
            <note place="top" resp="#h01" type="archival">vs 553</note>
            <lg type="poem">
                <head type="main" rend="underline">To the year 1889.</head>
                <milestone unit="glued"/>
                <lg type="linegroup">
                    <l>Have I no <add place="below"><metamark function="add" target="#a001">&#8248;</metamark></add><add place="above" xml:id="a001">weapon&#11840;</add>word for thee&#8212;some message brief<lb/> and fierce?
                    </l>
                    <l>Have I fought out <add place="below"><metamark function="add" target="#a002">&#8248;</metamark></add><add place="above" xml:id="a002">and done</add> indeed the battle? <del rend="overstrike">wholly?</del> is<lb/> there no shot left,</l>
                    <l>For all thy affectations, lisps, scorns, <add place="below"><metamark function="add" target="#a003">&#8248;</metamark></add><add place="above" xml:id="a003">manifold</add> silliness?</l>
                    <l>Nor for myself&#8212;my own rebellious self <unclear reason="illegible" resp="#bb" cert="medium">?</unclear> in thee?</l>
                </lg>
                <metamark function="emphasize"># <hi rend="circled">two <del rend="overstrike">leads</del></hi></metamark>
                <lg type="linegroup">
                    <l>Down, down, proud gorge&#8212;tho' choking thee,</l>
                    <l>Thy bearded throat and high-borne forehead to the <lb/>gutter,</l>
                    <l>Crouch low thy neck to eleemosynary gifts.</l>
                </lg>
            </lg>
            <signed rend="underline">Walt Whitman</signed>
            <note type="archival" place="bottom" hand="#h02">65</note>
            <pb facs="yal.00007.002.jpg" xml:id="leaf001v" type="verso"/>
            <note type="archival" resp="#h02" place="top"><hi rend="underline">Sky</hi> <lb/>$25.-</note>
            <note type="archival" place="bottom" hand="#h02">65</note>
        </body>
    </text>
