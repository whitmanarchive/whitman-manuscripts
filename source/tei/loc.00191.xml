   <pb xml:id="leaf001r" facs="loc_ew.00135.jpg" type="recto"/>
   <note hand="h02" type="archival" place="top">[Acc,19,078]</note>
   <lg type="poem">
          <head rend="underline">The <supplied resp="#bb" reason="torn away">d</supplied>ismantled Ship</head>
     <l>In some unused lagoo<supplied resp="#bb" reason="torn away">n,</supplied> some
          <lb/>nameless bay,</l>
     <l>On sluggish waters calm <supplied resp="#bb" reason="torn away">a</supplied>nd 
          <lb/>muddy, <add place="below"><metamark function="add" target="#a001">&#8248;</metamark></add><add place="above" xml:id="a001">anchor'd</add> near the shore,</l>
    <l>An old, disabled <subst><del rend="overstrike" seq="1">ship&#11840;</del> <add place="above" seq="2">gray and</add></subst> batter'd,
          <lb/><add place="below"><metamark function="add" target="#a002">&#8248;</metamark></add><add place="above" xml:id="a002">ships,</add> dismasted, broken,</l>
    <l>After <subst><del rend="overstrike" seq="1">her</del> <add place="above" seq="2">free</add></subst> voyages <subst><del rend="overstrike" seq="1">in</del> <add place="above" seq="2">to</add></subst> all the
          <lb/>seas of earth, <add place="below"><metamark function="add" target="#a003">&#8248;</metamark></add><add place="above" xml:id="a003">&#8212;the hulk of her,</add> haul'd up
          <lb/><add place="below"><metamark function="add" target="#a004">&#8248;</metamark></add><add place="above" xml:id="a004">at last</add> &amp; hawser'd<del rend="overstrike">,</del> tight,</l>
    <l>Lies <del rend="overstrike">anchor'd,</del> rusting,
     <lb/>mouldering, <subst><add seq="2" place="above">there.</add> <del rend="overstrike" seq="1">there.</del></subst></l>
   </lg>
   
   <note type="authorial" place="bottom">sent to Herald</note>
   <note type="authorial" place="bottom" rend="circled">probably printed in Herald 19th Feb. '88</note>
   <note hand="h03" type="archival" place="bottom">4&#188; &#2192;</note>
   
