   <pb xml:id="leaf001r" facs="loc_ej.00712_large.jpg" type="recto"/>
   <lg type="poem">
    <l><add place="below"><metamark target="#a001" function="add">&#8248;</metamark></add><add hand="#h02" place="above" xml:id="a001">Reck'd<del rend="overstrike" hand="#h02"><add>Unwreck'd</add></del> <add place="below"><metamark target="#a002" function="add">&#8248;</metamark></add><add place="above" hand="#h02" xml:id="a002">or unwreck'd</add> the <subst hand="#h02"><del rend="overstrike" seq="1">hour cannot</del><add place="above" seq="2">birth</add></subst><lb/> <subst hand="#h02"><del seq="1" rend="overstrike">can</del><del seq="3" rend="overstrike"><add seq="2" place="above">is</add></del><add place="above"  seq="4">can</add></subst> no longer <del rend="overstrike" hand="#h02">to</del> be postponed</add></l>
     <l><del rend="overstrike" hand="#h01">Soul plaudits! o'er<del rend="overstrike" hand="#h01"><add place="above" hand="#h01">back</add></del> the long path,<lb/> welcomes back echoes reverent and<lb/> deep <add hand="#h01" place="below"><metamark target="#a003" function="add">&#8248;</metamark></add><add place="above" hand="#h01" xml:id="a003">backward</add> echoes</del></l>
     <l>If <del rend="overstrike" hand="#h01">thou</del> still <del hand="#h01" rend="overstrike">Knowst</del> thou <subst hand="#h01"><del rend="overstrike" seq="1">Know'st</del><add place="above" seq="2">hear'st</add></subst>, hear<lb/> us, <subst hand="#h01"><del rend="overstrike" seq="1">new p<gap extent="a few characters" reason="illegible"/>ts</del><add place="above" seq="2">our voice</add></subst><del rend="overstrike" hand="#h01">, new people race, arts<lb/> lands</del></l>
    <l>One manifold, huge acclaim <add place="below"><metamark target="#a004" function="add">&#8248;</metamark></add><add place="above" hand="#h01" xml:id="a004">rounded</add> to thee <add place="below"><metamark target="#a005" function="add">&#8248;</metamark></add><add place="above" hand="#h01" xml:id="a005" rend="marked">&#8212;a world to thee</add></l>
    <l>Voic<subst hand="#h01"><del rend="overstrike" seq="1">e</del><add place="above" seq="2">ing</add></subst> <subst hand="#h01"><del seq="1">out as one</del><add place="below" seq="2"><metamark target="#a006" function="add">&#8248;</metamark></add><add place="above" hand="#h01" xml:id="a006" seq="3">for once&#8212;</add></subst>&#8212;new races, lands, arts<lb/> <subst hand="#h01"><del rend="overstrike" seq="1">all</del><add place="above" seq="2">all</add></subst> to thee</l>
    <l>O'er the long path, <add place="below"><metamark target="#a007" function="add">&#8248;</metamark></add><add place="above" hand="#h01" xml:id="a007">to thee</add> one vast consensus,<lb/> north, south, east west,</l>
    <l>Soul-plaudits! memories! deep backward reverent<lb/> <del rend="overstrike" hand="#h01"><unclear reason="illegible" resp="#ja">memories</unclear></del> echoes</l>
   </lg>
