   <pb xml:id="leaf001r" facs="YCAL_MSS-13-3.jpg" type="recto"/>
   <note type="archival" place="top" hand="#h02">560</note>
   <note hand="#h01" place="top"><del rend="overstrike">The obstinate gloomy aches, lethargy, constipation</del></note>
   <note hand="#h01" place="top">T</note>
   <head type="main" rend="Underline">As I Sit <subst><del rend="overstrike" seq="1">thinking</del><add place="above" seq="2">writing</add></subst> here</head>
   <lg type="poem">
    <l><del rend="overstrike">For one,</del> as I sit <del rend="overstrike">here</del> <subst><del rend="overstrike" seq="1">thinking</del><add place="above" seq="2">writing</add></subst> here <add place="below"><metamark target="#a001" function="add">&#8248;</metamark></add><add place="above" xml:id="a001">sick and</add> grown old, <del rend="overstrike"><add place="below"><metamark target="#a002" function="add">&#8248;</metamark></add><add place="above" xml:id="a002">and sick,</add></del></l>
     <l>Not my least <subst><del rend="overstrike" seq="1">dread</del><add place="above" seq="2">burden is</add></subst> that <del rend="overstrike" seq="1">the</del><add place="above" seq="2">dulness of the</add> years, querilities,</l>
    <l><subst><del rend="overstrike" seq="1">The obstinate</del><add place="above" seq="2">The ungracious</add></subst> glooms, aches, lethargy, constipation, <add place="below"><metamark target="#a003" function="add">&#8248;</metamark></add><add place="above" xml:id="a003" rend="marked">whimpering solitudes</add></l>
    <l><del rend="overstrike"><add><metamark target="#a004" function="add">&#8248;</metamark></add><add place="above" xml:id="a004">as I grow old</add></del> May filter in my daily songs. I fear.</l>
   </lg>
   

   <pb xml:id="leaf001v" facs="YCAL_MSS-13-4.jpg" type="verso"/>
   
</body>
