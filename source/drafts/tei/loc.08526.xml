            <note type="authorial" place="top" hand="#h01">all right&#8212;pass on to proof reader to be cast</note>
            
            <note type="editorial" hand="#h03" place="top" rend="underline"><unclear reason="illegible" cert="low" resp="#sd">F</unclear></note>
            
