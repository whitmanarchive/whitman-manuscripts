  <body>
   
   <pb xml:id="leaf001r" facs="uva.00002.001.jpg" type="recto"/>
   <lg type="poem">
   <head>
    <subst><del rend="overstrike" seq="4"><add place="left" seq="2">As <add place="above" seq="3">unnamed</add> soldiers' deaths recalling</add></del>
     <del rend="overstrike" seq="1"><hi rend="underline">"Unknown"</hi></del> 
     <del rend="overstrike" seq="6"><add place="above" rend="underline" seq="5">As <subst><add place="above" seq="2">a million</add> <del rend="ovestrike" seq="1">unnamed</del></subst> soldiers' deaths recalling</add></del></subst>
   </head>
   
     <l>As I sit <del rend="overstrike"><add place="above">alone</add></del> in <del rend="overstrike">the</del> twilight<add place="below"><metamark function="add" target="#a001">&#8248;</metamark></add><add place="above" xml:id="a001">alone</add> by the flicker<lb/>
        of oak&#11840;flame,</l>
    <l>Musing on long-past war-<subst><del seq="1" rend="overstrike">days&#8212;</del><add seq="2" place="above">scenes&#8212;</add></subst>on <subst><del seq="1" rend="overstrike">many and</del> <del seq="3" rend="overstrike"><add seq="2" place="above">crow</add></del> <add seq="4" place="above"><add seq="5" place="above">the</add> swarms of</add></subst><lb/>
        <del rend="overstrike">many</del> <del rend="overstrike">a</del> dead <add place="below"><metamark function="add" target="#a002">&#8248;</metamark></add><add place="above" xml:id="a002">and vanish'd</add> soldier<add>s</add>, <del rend="overstrike">thousands,</del></l>
    <!-- <delSpan rend="overstrike" spanTo="#d001"/> -->
     <l><del rend="overstrike">Belongings of darkness,</del></l>
<!--    <anchor xml:id="d001"/> -->
    <l>
     <add place="above">The</add> 
     <subst>
      <del rend="overstrike" seq="1">Intangible,</del> <del rend="overstrike" seq="3"><add place="below" seq="2"><metamark function="add" target="#a003">&#8248;</metamark></add><add place="above" xml:id="a003" seq="2">unidentified,</add></del>
     </subst>
     <del rend="overstrike">the</del> faded out, <add place="below"><metamark function="add" target="#a004">&#8248;</metamark></add><add place="above" xml:id="a004">the vacant names</add> the 
     <subst>
      <del seq="1" rend="overstrike">vacant</del> <add seq="2" place="above">unindented</add>
     </subst> air's, <add place="below"><metamark function="add" target="#a005">&#8248;</metamark></add><add place="above" xml:id="a005">and sea's,</add> the<lb/>
     
     <del rend="overstrike"><unclear reason="illegible" resp="#bb" cert="medium">bri</unclear> unindented seas</del> <add place="above"><del rend="overstrike">never named;</del> unreturn'd <subst><del seq="1" rend="overstrike">after</del><add seq="2" place="above">from</add></subst> battle</add>
    </l>
    <!--<delSpan rend="overstrike" spanTo="#d002"/>-->
    
    
    <l>
     <del rend="overstrike">The</del> <add place="below"><metamark function="add" target="#a016">&#8248;</metamark></add><add place="above" xml:id="a016">
      <subst>
       <del seq="1" rend="overstrike">And then</del> <del rend="overstrike" seq="4"><add seq="2" place="above">With<add place="above" seq="3">the</add></add></del></subst>

       <del rend="overstrike">the battle-</del><del rend="overstrike">truce after, </del>
      <subst>
       <del rend="overstrike" seq="1">and</del> <del rend="overstrike" seq="3"><add place="above" seq="2">&#8212;with grim</add></del>
       </subst>
     </add>
     <del rend="overstrike">truce after the battle, and <add place="above" xml:id="a006">the</add> <del rend="overstrike"><gap reason="illegible" extent="one character" resp="#bb"/></del> burial squad,</del>
    </l>
    
    <!--<anchor xml:id="d002"/>-->
     <l>With the brief truce after, and grim burial squads, <add place="above">and</add> hasty trench<lb/>
        <del rend="overstrike">and the hasty trench;</del>
     </l>
     <l>
      (<add place="below"><metamark function="add" target="#a007">&#8248;</metamark></add><add place="above" xml:id="a007">Even</add> Here in <subst>
       <del seq="1" rend="overstrike">the</del> <add seq="2" place="below"><metamark function="add" target="#a008">&#8248;</metamark></add><add seq="3" place="above" xml:id="a008">my room-</add></subst>shadows, in the flickering flames,</l>
     <l>
      <subst>
       <del seq="1" rend="overstrike">By</del> <add seq="2" place="below"><metamark function="add" target="#a009">&#8248;</metamark></add><del rend="overstrike" seq="4"><add seq="3" place="above" xml:id="a009">The</add></del> <add seq="5" place="above">I see the</add></subst> ranks <del rend="overstrike">on ranks</del> on&#11840;filing, <add place="below"><metamark function="add" target="#a010">&#8248;</metamark></add><add place="above" xml:id="a010">I hear the rhythmic tramp,</add> the spectral armies<lb/>
        moving,)</l>
     <l>The mystic 
      <subst>
      <del seq="1" rend="overstrike">roll</del><add seq="2" place="below"><metamark function="add" target="#a011">&#8248;</metamark></add><add seq="3" place="above" xml:id="a011"><del seq="4" rend="overstrike">ranks and</del> names</add>
      </subst> from all America, North<lb/>
        South, East, West.</l>
     <l>From wooded Maine, New England's farms<lb/>
        from fertile Pennsylvania,</l>
     <l>The boundless West, the South, the Carolinas,<lb/>
        Texas,</l>
     <l>Ye million unwrit names, left blank, <add place="below"><metamark function="add" target="#a012">&#8248;</metamark></add><add place="above" xml:id="a012">the war's</add> unknown,<add place="below"><metamark function="add" target="#a013">&#8248;</metamark></add><add place="above" xml:id="a013">or North or South</add></l>
    <metamark rend="bracket-left" spanTo="#s001"/>
     <l>
      <subst>
       <del seq="1" rend="overstrike">I put ye</del> <add seq="2" place="above">Deep,</add></subst>
      deep <add place="below"><metamark function="add" target="#a014">&#8248;</metamark></add><add place="above" xml:id="a014">to be</add> to-night within my thought <add place="below"><metamark function="add" target="#a015">&#8248;</metamark></add><add place="above" xml:id="a015">embalm'd,</add> recorded,</l>
     <l>And in these lines,</l>
     <l>A flash of love&#8212;a special 
      <subst>
      <del seq="1" rend="overstrike">hour</del> <add seq="2" place="above">word</add>
      </subst> for you&#8212;each<lb/>
        name recall'd by one from the darkness, and <del rend="overstrike">the</del> ashes,</l>
    <anchor xml:id="s001"/>
<!--    loses -->
   </lg>
   
