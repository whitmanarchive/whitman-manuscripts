<!--  EDIT THE VALUE OF @FACS TO CORRESPOND WITH THE NAME OF THE RECTO IMAGE  -->
   <pb xml:id="leaf001r" facs="loc_cm.00041.jpg" type="recto"/>
   <note hand="#h03" place="top" type="authorial">3</note>
  <note rend="circled" type="authorial" place="right" hand="#h02">follow copy punctuation &amp; c</note>
   <div>
    <head><subst><del rend="overstrike" hand="#h02" seq="1">Walt Whitman at present.</del><add hand="h03" seq="2" place="below"><metamark function="adjust" target="#j001">&#182;</metamark></add><add hand="#h02" place="below" seq="3" xml:id="j001">About myself at present.</add></subst></head>
     
    <p><subst><del rend="overstrike" hand="#h04" seq="1"><del hand="#h03">The poet above named</del></del><add hand="#h04" place="above" seq="2"><subst><del rend="overstrike" hand="#h02" seq="3">I</del><add hand="#h02" place="right" rend="marked" seq="4">I</add></subst></add></subst> will soon enter upon <subst hand="#h04"><del rend="overstrike">his</del><add place="above">my</add></subst> 73d year, if <subst rend="overwrite" hand="#h04"><del>he</del><add>I</add></subst> live<del rend="overstrike" hand="#h03"><del rend="overstrike" hand="#h04">s</del></del>. <subst rend="overwrite"><del>He</del><add>I</add></subst> <subst hand="#h02"><del rend="overstrike" seq="1">has</del><add place="above">have</add></subst> passed an active life, as country school-teacher, printer, carpenter<add hand="#h03">,</add> <subst hand="#h03"><del rend="overstrike" seq="1">and</del><add place="below" seq="2"><metamark function="add" target="#a001">&#8248;</metamark></add><add place="above" xml:id="a001" seq="3">author and</add></subst> journalist, <subst><del rend="overstrike" hand="#h02" seq="1">living</del><add place="below" seq="2" hand="#h03"><metamark function="add" target="#a002">&#8248;</metamark></add><add place="above" hand="#h03" xml:id="a002" seq="3">domiciled</add></subst> in nearly all the United States and pricipal cities, North and South<subst hand="#h02"><del rend="overstrike" seq="1">.</del><add seq="2">&#8212;</add></subst> <subst rend="overwrite" hand="#h04"><del>He</del><add><del rend="overstrike" hand="#h02">I</del></add></subst> went to the front <add place="below" hand="#h03"><metamark function="add" target="#a003">&#8212;</metamark><add place="above" hand="#h03" xml:id="a003"><subst hand="#h02"><del rend="overstrike" seq="1">launching</del><add place="above" seq="2">moving about</add></subst> and occupied</add></add> as army nurse and missionary during the secession war<add hand="#h04">,</add> 1861 to <add hand="#h02">'</add>65, <add place="below" hand="#h03"><metamark function="add" target="#a004">&#8248;</metamark></add><add place="above" hand="#h03" xml:id="a004">and</add> in the Virginia hospitals and after <add hand="#h03">the</add><add place="below" hand="#h02"><metamark function="add" target="#a005">&#8248;</metamark></add><add hand="#h02" place="above" xml:id="a005"><del hand="#h02" rend="overstrike">southern</del></add> battles <add place="below" hand="#h02"><metamark function="add" target="#a006">&#8248;</metamark></add><add hand="#h02" place="above" xml:id="a006">of that time,</add> tending the <subst rend="overwrite" hand="#h04"><del>n</del><add>N</add></subst>orthern and <subst hand="#h04"><del>s</del><add>S</add></subst>outhern wounded alike, <add place="below" hand="#h03"><metamark function="add" target="#a007">&#8248;</metamark></add><add place="above" hand="#h03" xml:id="a007">&#8212;</add> worked <subst hand="#h03"><del rend="overstrike" seq="1">there</del><add place="above" seq="2">down south</add></subst> and in Washington city arduously three years,<add place="below" hand="#h03"><metamark function="add" target="#a008">&#8248;</metamark></add><add place="above" hand="#h03" xml:id="a008">&#8218;</add> contracted the paralysis which <subst hand="#h04" rend="overwrite"><del>he</del><add><subst hand="#h02"><del rend="overstrike" seq="1">I</del><add place="above" seq="2">I</add></subst></add></subst> <subst hand="#h02"><del rend="overstrike">ha<subst rend="overwrite" hand="#h04"><del>s</del><add>v</add></subst></del><add place="above">have</add></subst> suffered ever since,<add hand="#h02" place="below"><metamark function="add" target="#a009">&#8248;</metamark></add><add place="above" hand="#h02" xml:id="a009">&#8212;</add> and now live<del rend="overstrike" hand="#h02">s</del> in a little cottage of <subst rend="overwrite" hand="#h04"><del>his</del><add>my</add></subst> <add place="above" hand="#h02">my</add> own, <subst hand="#h02"><del rend="overstrike" seq="1">on</del><add place="above" seq="2">near</add></subst> the Delaware.<add hand="#h03" place="above"><metamark function="add" target="#a010">&#8248;</metamark></add><add place="above" hand="#h03" xml:id="a010">in New Jersey.</add></p>
   </div>
   
